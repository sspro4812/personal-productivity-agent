
{
  "manifest_version": 3,
  "name": "Productivity Agent Tab Tracker",
  "version": "1.0.0",
  "description": "Optionally tracks active browser tabs for your Personal Productivity Agent.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Productivity Agent Tab Tracker"
  }
}
